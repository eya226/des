# Printful API Key - for fetching products
PRINTFUL_API_KEY="your_printful_api_key_here"

# Stripe Secret Key - for processing payments
STRIPE_SECRET_KEY="your_stripe_secret_key_here"

# Hugging Face API Token (Optional) - for AI text generation
# May be required for certain models or to increase rate limits.
HUGGING_FACE_API_TOKEN="your_hugging_face_api_token_here"

# Frontend Domain - for Stripe redirect URLs
FRONTEND_DOMAIN="http://localhost:3000"
